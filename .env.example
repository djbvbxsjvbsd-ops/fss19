DISCORD_TOKEN=
GUILD_ID=
OWNER_ID=SEU_ID_DO_DISCORD
PORT=3000
FARM_ID=1
# Deixe vazio para o bot achar o save sozinho (ou coloque o caminho completo da pasta savegameN)
SAVEGAME_PATH=
# Deixe vazio para achar a pasta mods sozinho
MODS_PATH=
ADMIN_PASSWORD=1020
GAME_PATH=C:\Program Files (x86)\Steam\steamapps\common\Farming Simulator 19
# (opcional) ID de uma categoria do Discord para agrupar os canais privados
CATEGORY_ID=

# ---- Railway ----
# No Railway NÃO use este arquivo: coloque as variáveis na aba Variables.
# Com um Volume anexado (ex.: /data) o servidor usa RAILWAY_VOLUME_MOUNT_PATH sozinho.
# DATA_DIR=/data

# ---- sync-save.bat (roda no PC do jogo) ----
# Endereço do seu servidor no Railway (o mesmo do app) e a MESMA ADMIN_PASSWORD do Railway
# SYNC_URL=https://seu-bot.up.railway.app
# (opcional) tamanho máximo, em MB, dos mods que o sync envia ao servidor (só os usados nos veículos). Padrão 100
# SYNC_MAX_MOD_MB=100
